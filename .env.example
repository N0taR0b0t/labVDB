# Set this to connect to a Qdrant server (recommended for production and 20k+ PDFs).
# If unset, the app falls back to embedded local Qdrant (dev/testing only).
QDRANT_URL=http://localhost:6333

# Pin PyTorch/OpenMP thread count to all available cores.
# No effect on batch indexing throughput (PyTorch already parallelises batch embed
# internally), but cuts query encode latency by ~15% and raises query throughput
# by ~15% on a 4-core CPU. Set to match nproc on your machine.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
